# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Server-only service-role key (Project Settings -> API). Used to redeem invite codes and create
# invited accounts. Never prefix with NEXT_PUBLIC_, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Emails allowed in without an invite code, e.g. the owner (comma-separate for more)
ALLOWED_EMAILS=you@example.com

# Google Gemini (https://aistudio.google.com/apikey) - server-side only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Per-student AI limits (rolling windows)
AI_HEAVY_PER_DAY=10
AI_LIGHT_PER_HOUR=120
